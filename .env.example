# Copia este archivo a .env y completa los valores.
# Reinicia `npm run dev` después de cada cambio: Vite solo lee el entorno al arrancar.
#
# IMPORTANTE: toda variable con prefijo VITE_ se incluye en el JavaScript
# que descarga el navegador. No son secretos. No pongas aquí la clave
# service_role ni una clave sb_secret_ de Supabase.

# URL del proyecto. Ejemplo real: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://Mi-Cartelera-Personal.supabase.co

# Clave pública: anon (JWT cuyo role es "anon") o publishable (sb_publishable_...).
# Nunca uses service_role ni sb_secret_.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNlZXZseXpiZHZtdnNpbHZ2eG5wIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI0MzI1NzMsImV4cCI6MjEwODAwODU3M30.wVovaWY8dt-_1Zio4McNhFgSG5IMopRAV4Vw1yrKfwY

# Clave de lectura de TMDB. Puede ser la API Key v3 o el Read Access Token (empieza por eyJ).
# También queda visible en el navegador. No le des permisos de escritura en TMDB.
VITE_TMDB_API_KEY=73db22c0667caeb8012c57ec251dbebf

# Opcionales. Si las omites, la aplicación usa estos valores.
# VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
# VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
